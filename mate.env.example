# LeapMotor Mate server configuration — one KEY=VALUE per line, values taken literally.
# The installers write this file for you; this is the full list for reference.

# Where the database, Mate itself and its Python environments live.
# MATE_DATA_DIR=/var/lib/leapmotor-mate          (Windows: C:\ProgramData\LeapMotorMate)

# Port of the web UI (listens on all interfaces).
MATE_PORT=4000

# Password for the web UI. Set it: the UI can unlock the car.
# (Alternatively set one in Mate's Settings page — but until then the page is open.)
MATE_AUTH_PASSWORD=change-me

# auto   = install new Mate releases by themselves (a few seconds of downtime, automatic rollback)
# notify = only write "a new version is available" to the log; install with `mate-server update`
# off    = never ask
MATE_UPDATE=auto
MATE_UPDATE_INTERVAL_HOURS=6

# Run exactly this Mate version and never move off it.
# MATE_VERSION_PIN=4.17.0

# Base Python for Mate's environments (the installers provide 3.12; normally leave unset).
# MATE_PYTHON=/opt/leapmotor-mate/python/cpython-3.12.x-linux-x86_64-gnu/bin/python3.12

# ── Everything below is passed straight to Mate ──────────────────────────────────────────────
# Time zone for the UI (Mate otherwise asks during setup).
# TZ=Europe/Rome
# Behind a reverse proxy that rewrites Host: the public origin, so write requests are accepted.
# MATE_TRUSTED_ORIGINS=https://mate.example.com
# Pages allowed to embed Mate in a frame (e.g. a Home Assistant dashboard).
# MATE_FRAME_ANCESTORS=http://homeassistant.local:8123
